<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sachinsharma.screenshotclipboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/sachinsharma/bin/screenshot-clipboard-watcher.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LowPriorityIO</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/sachinsharma/Library/Logs/screenshot-clipboard-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sachinsharma/Library/Logs/screenshot-clipboard-watcher.err.log</string>
</dict>
</plist>
